# --- Playwright QA Agent: never commit these ---------------------------------

# Real credentials. The .example file IS committed; the real .env is not.
credentials/.env
credentials/*.env
!credentials/.env.example

# Saved login sessions. These contain live session cookies — treat as secrets.
.auth/

# Generated by bddgen in bdd mode. Never edit, never commit.
.features-gen/

# Test results. A trace contains the live session cookie — treat as sensitive.
outcome/
test-results/
playwright-report/
blob-report/
.playwright/

# Node
node_modules/
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
