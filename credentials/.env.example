# =============================================================================
#  credentials/.env.example
#
#  HOW TO USE
#    1. Copy this file to  credentials/.env
#    2. Fill in the real values
#    3. Never commit credentials/.env  (.gitignore already blocks it)
#
#  Keep this .example file in git with EMPTY values, so your team knows
#  which variables are needed.
#
#  RULES
#    - Use dedicated TEST accounts. Never a real customer or your own admin login.
#    - Point BASE_URL at staging/QA. Pointing it at production is refused.
#    - The variable NAMES here must match qa.config.yaml.
# =============================================================================

# --- Where the app lives -----------------------------------------------------
BASE_URL=https://staging.example.com

# --- Test accounts, one pair per role in qa.config.yaml ----------------------
CUSTOMER_USER=
CUSTOMER_PASS=

ADMIN_USER=
ADMIN_PASS=

# --- Optional ----------------------------------------------------------------
# Only if your app needs an API key to seed or clean up test data.
# API_TOKEN=

# Base URL of a mail-catcher (MailHog, Mailpit) if you test email flows.
# MAIL_API_URL=
